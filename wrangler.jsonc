{
  "name": "warevolt",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Send /api/* to the Worker even if a static file could match.
    "run_worker_first": ["/api/*"]
  }
}
